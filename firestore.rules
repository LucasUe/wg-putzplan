rules_version = '2';

// Bewusst einfache Regeln: Die WG-App hat keine Nutzerkonten, der WG-PIN schützt nur die Oberfläche.
// Es werden keine sensiblen Daten gespeichert. Für mehr Schutz später Firebase Auth einbauen.
// `sentReminders` (Dedup der Erinnerungen) und `snapshots` werden vom Reminder-Skript
// über das Web-SDK geschrieben, daher ebenfalls offen.
service cloud.firestore {
  match /databases/{database}/documents {
    match /household/{doc} {
      allow read, write: if true;
    }
    match /tasks/{doc} {
      allow read, write: if true;
    }
    match /absences/{doc} {
      allow read, write: if true;
    }
    match /completions/{doc} {
      allow read, write: if true;
    }
    match /snapshots/{doc} {
      allow read, write: if true;
    }
    match /pushSubscriptions/{doc} {
      allow read, write: if true;
    }
    match /sentReminders/{doc} {
      allow read, write: if true;
    }
  }
}
